{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source and prior-judgment bound A2 teaching corrections",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "confirmation_basis",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "policy_id": {
      "enum": [
        "a2-organic-stereochemistry-and-carbonyl-reduction-2026-10-29",
        "a2-foundation-organic-and-aromatic-hybridisation-2026-10-29",
        "a2-inorganic-foundations-2026-10-29",
        "a2-nitrogen-environment-organizational-placement-2026-10-29"
      ]
    },
    "confirmation_basis": {
      "type": "string",
      "minLength": 20
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "material_fingerprint",
          "before_teaching_fingerprint",
          "required_chapters",
          "knowledge_tags",
          "reason"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "material_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "before_teaching_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "required_chapters": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "contains": {
              "enum": [
                3,
                6,
                7,
                9,
                11
              ]
            }
          },
          "knowledge_tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 30
          }
        }
      }
    }
  }
}
