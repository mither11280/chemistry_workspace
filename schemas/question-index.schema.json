{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chemistry Workspace question-index",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "coordinate_system": {
      "const": "pdf-point-unrotated-cropbox-top-left-v1"
    },
    "bank_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "revision": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "name": {
            "type": "string"
          },
          "english": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "english"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "exam_board": {
            "type": "string",
            "minLength": 1
          },
          "qualification": {
            "type": "string",
            "minLength": 1
          },
          "subject_code": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2200
          },
          "session": {
            "type": "string",
            "minLength": 1
          },
          "paper": {
            "type": "integer",
            "minimum": 1
          },
          "variant": {
            "type": "integer",
            "minimum": 0
          },
          "original_question_number": {
            "type": "string",
            "minLength": 1
          },
          "marks": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
            },
            "uniqueItems": true
          },
          "question": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
              },
              "regions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "page_index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "bbox": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    }
                  },
                  "required": [
                    "page_index",
                    "bbox"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              }
            },
            "required": [
              "source_id",
              "regions"
            ],
            "additionalProperties": false
          },
          "answer": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
              },
              "regions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "page_index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "bbox": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    }
                  },
                  "required": [
                    "page_index",
                    "bbox"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "type": {
                "enum": [
                  "mcq",
                  "regions"
                ]
              },
              "value": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              }
            },
            "required": [
              "source_id",
              "regions",
              "type"
            ],
            "additionalProperties": false
          },
          "metadata": {
            "type": "object",
            "properties": {
              "teaching": {
                "type": "object",
                "properties": {
                  "taxonomy_id": {
                    "enum": [
                      "chemistry-workspace-teaching19-1.0.0",
                      "chemistry-workspace-a2-teaching12-1.0.0"
                    ]
                  },
                  "status": {
                    "enum": [
                      "ready",
                      "pending"
                    ]
                  },
                  "primary_chapter": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 19
                  },
                  "required_chapters": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 19
                    },
                    "uniqueItems": true
                  },
                  "candidate_chapters": {
                    "description": "Unconfirmed retrieval hints for the holding area; never used for chapter selection.",
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 19
                    },
                    "uniqueItems": true
                  },
                  "prerequisites": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "parent_question_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "part_path": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z]+$"
                    },
                    "maxItems": 2
                  },
                  "source_order": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "own_regions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "page_index": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "bbox": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 4,
                          "maxItems": 4
                        }
                      },
                      "required": [
                        "page_index",
                        "bbox"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "contexts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "global_key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "regions": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "page_index": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "bbox": {
                                "type": "array",
                                "items": {
                                  "type": "number"
                                },
                                "minItems": 4,
                                "maxItems": 4
                              }
                            },
                            "required": [
                              "page_index",
                              "bbox"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "key",
                        "regions"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "issues": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "missing_prerequisites": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "official_answer_label": {
                    "type": "string",
                    "pattern": "^\\d+\\([a-z]\\)(?:\\([ivx]+\\))?$",
                    "description": "Printed official MS label when an unlabelled single-task QP is indexed under its original whole-number label."
                  }
                },
                "required": [
                  "taxonomy_id",
                  "status",
                  "primary_chapter",
                  "required_chapters",
                  "prerequisites",
                  "parent_question_id",
                  "part_path",
                  "source_order",
                  "own_regions",
                  "contexts",
                  "evidence",
                  "issues"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "taxonomy_id": {
                          "const": "chemistry-workspace-a2-teaching12-1.0.0"
                        }
                      },
                      "required": [
                        "taxonomy_id"
                      ]
                    },
                    "then": {
                      "properties": {
                        "primary_chapter": {
                          "maximum": 12
                        },
                        "required_chapters": {
                          "items": {
                            "maximum": 12
                          }
                        },
                        "candidate_chapters": {
                          "items": {
                            "maximum": 12
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "required": [
          "question_id",
          "exam_board",
          "qualification",
          "subject_code",
          "year",
          "session",
          "paper",
          "variant",
          "original_question_number",
          "marks",
          "topics",
          "question",
          "answer",
          "metadata"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "metadata"
              ],
              "properties": {
                "metadata": {
                  "required": [
                    "teaching"
                  ],
                  "properties": {
                    "teaching": {
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "const": "pending"
                        }
                      }
                    }
                  }
                }
              }
            },
            "then": {},
            "else": {
              "properties": {
                "question": {
                  "properties": {
                    "regions": {
                      "minItems": 1
                    }
                  }
                },
                "answer": {
                  "properties": {
                    "regions": {
                      "minItems": 1
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "coordinate_system",
    "bank_id",
    "revision",
    "topics",
    "questions"
  ],
  "additionalProperties": false
}
