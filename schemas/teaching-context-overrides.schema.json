{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chemistry-workspace.local/schemas/teaching-context-overrides.schema.json",
  "title": "Explicit source-introduction corrections for teaching-bank production",
  "type": "object",
  "required": ["schema_version", "questions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "questions": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9._:-]+$"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from_question_id", "context_key", "reason"],
          "properties": {
            "from_question_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
            "context_key": {"type": "string", "minLength": 1},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
